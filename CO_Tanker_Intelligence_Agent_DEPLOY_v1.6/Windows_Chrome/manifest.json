{
  "manifest_version": 3,
  "name": "CO Tanker Intelligence | Regulatory Watch",
  "short_name": "CO Intelligence",
  "version": "1.6.0",
  "description": "Tanker source briefings, PSC, SIRE 2.0 and CDI-M preparation, study quizzes, port tasks and offline notes.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.imo.org/*",
    "https://www.gov.cy/*",
    "https://parismou.org/*",
    "https://www.intertanko.com/*",
    "https://www.ocimf.org/*",
    "https://www.emsa.europa.eu/*",
    "https://emsa.europa.eu/*",
    "https://www.bimco.org/*",
    "https://echa.europa.eu/*",
    "https://www.gov.uk/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Chief Officer Intelligence"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "dashboard.html"
}
